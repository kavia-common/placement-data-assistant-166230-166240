# Copy to .env and fill real values
OPENROUTER_API_KEY=
SITE_URL=http://localhost:3000

# Pinecone v2 REST (preferred)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=connecto-placement-records
# Example host: <index-name>-<project-id>.svc.<region>.pinecone.io
PINECONE_HOST=

# Optional overrides
EMBEDDING_MODEL=meta-llama/llama-text-embed-v2
GENERATION_MODEL=openrouter/gpt-oss-20b
