# Connecto (Beta) - Backend environment example
# Copy to .env and fill with your real values. Do NOT commit your .env.

# OpenRouter (LLM)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SITE_URL=http://localhost:3000

# Pinecone
PINECONE_API_KEY=pcn-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Name for your index (logical)
PINECONE_INDEX_NAME=connecto-placement-records
# Direct host for your Pinecone index (v2). Example: your-index-xxxxxx.svc.aped-4627-b74a.pinecone.io
PINECONE_HOST=
# Optional (legacy/metadata)
PINECONE_ENVIRONMENT=
PINECONE_PROJECT_ID=
